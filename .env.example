# ===========================================================================
#  AI Code Review Agent - example configuration
#  ------------------------------------------------------------------------
#  This file contains NO real credentials and is safe to commit.
#
#  TO SET UP:
#    1. Copy this file to .env       (cp .env.example .env)
#    2. Put your own key in .env
#    3. Never commit .env - it is already listed in .gitignore
# ===========================================================================


# ---------------------------------------------------------------------------
# 1. WHICH PROVIDER TO USE
# ---------------------------------------------------------------------------
# One of: groq | openrouter | ollama | openai | mock
#
#   groq        Recommended. Free, fast, no credit card required.
#               Sign up at https://console.groq.com and create an API key.
#   openrouter  Free tier available; some models need a small credit balance.
#   ollama      Runs a model on your own machine. No key and no internet
#               needed, but you must install Ollama first.
#   openai      Paid. Use only if you already have credit.
#   mock        No model at all. The application falls back to a small
#               offline static analyser. Useful for testing the UI, but it
#               does NOT demonstrate the AI features.
LLM_PROVIDER=groq


# ---------------------------------------------------------------------------
# 2. YOUR API KEY
# ---------------------------------------------------------------------------
# Replace the placeholder below with your own key in your local .env file.
# Leave it as the placeholder here.
#
# If this is left unset, the application starts in OFFLINE MODE and says so
# clearly in both the GUI and the CLI.
LLM_API_KEY=YOUR_LOCAL_API_KEY_HERE


# ---------------------------------------------------------------------------
# 3. MODEL AND ENDPOINT (optional - sensible defaults per provider)
# ---------------------------------------------------------------------------
# Leave these commented out to use the default for your chosen provider.
#
# NOTE: providers retire model IDs every few months, and a retired ID returns
# "The model name was not found". If that happens, open your provider's model list
# and set LLM_MODEL below to a current one. For Groq that list is at
# https://console.groq.com/docs/models
#
#   groq        https://api.groq.com/openai/v1    openai/gpt-oss-120b
#   openrouter  https://openrouter.ai/api/v1      google/gemma-4-31b-it:free
#   ollama      http://localhost:11434/v1         llama3.1
#   openai      https://api.openai.com/v1         gpt-4o-mini

# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b


# ---------------------------------------------------------------------------
# 4. BEHAVIOUR (optional)
# ---------------------------------------------------------------------------

# How long to wait for one model reply, in seconds.
LLM_TIMEOUT_SECONDS=60

# How many times to retry a failed request before giving up.
# This is what produces the automatic retry shown in sequence diagram SD01.
LLM_MAX_RETRIES=3

# Sampling temperature. Analysis uses a low value so results are repeatable.
LLM_TEMPERATURE=0.2

# Maximum length of a single reply, in tokens.
LLM_MAX_TOKENS=2048

# Cache identical requests in memory, so re-analysing an unchanged file is free.
LLM_CACHE_ENABLED=true

# Print one line per model call to standard error (token counts and latency).
LLM_VERBOSE=false

# Maximum number of tool invocations in one autonomous audit (feature F11).
AGENT_MAX_STEPS=8

# Test framework used by the test-generation feature. Leave unset to infer it
# from the file's language.
# TEST_FRAMEWORK=JUnit 5
